[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/launch/splash.gd" id="script"]
[ext_resource type="Theme" path="res://scenes/launch/launch_theme.tres" id="theme"]
[ext_resource type="Texture2D" path="res://scenes/launch/assets/scrollmapper_splash.png" id="splash"]
[ext_resource type="PackedScene" path="res://scenes/launch/project_card.tscn" id="credit"]

[node name="Splash" type="Control" node_paths=PackedStringArray("credits_grid")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")
credits_grid = NodePath("Margin/Layout/Credits")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.009, 0.019, 0.035, 1)
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 36
theme_override_constants/margin_right = 36
theme_override_constants/margin_top = 24
theme_override_constants/margin_bottom = 28
mouse_filter = 2

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 18
mouse_filter = 2

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
mouse_filter = 2

[node name="Brand" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Muted"
theme_override_font_sizes/font_size = 13
text = "S C R O L L M A P P E R"
mouse_filter = 2

[node name="Context" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
horizontal_alignment = 2
theme_type_variation = &"Muted"
theme_override_font_sizes/font_size = 12
text = "TEXT ANALYSIS & CROSS-REFERENCE MAPPING"
text_overrun_behavior = 3
mouse_filter = 2

[node name="Artwork" type="TextureRect" parent="Margin/Layout"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
texture = ExtResource("splash")
expand_mode = 1
stretch_mode = 5
mouse_filter = 2

[node name="ContinueHint" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.79, 0.86, 0.90, 1)
theme_override_font_sizes/font_size = 15
text = "Click anywhere or press any key to continue"
horizontal_alignment = 1
autowrap_mode = 3
mouse_filter = 2

[node name="CreditsHeading" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_type_variation = &"Muted"
theme_override_font_sizes/font_size = 11
text = "BUILT WITH  /  DATA & OPEN-SOURCE PROJECTS"
mouse_filter = 2

[node name="Credits" type="GridContainer" parent="Margin/Layout"]
layout_mode = 2
columns = 4
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 12
mouse_filter = 2

[node name="Godot" parent="Margin/Layout/Credits" instance=ExtResource("credit")]
layout_mode = 2
custom_minimum_size = Vector2(0, 88)
title = "Godot Engine"
description = "Open-source engine  ↗"
destination_url = "https://godotengine.org/"
tooltip_text = "https://godotengine.org/"
artwork = null

[node name="BibleDatabases" parent="Margin/Layout/Credits" instance=ExtResource("credit")]
layout_mode = 2
custom_minimum_size = Vector2(0, 88)
title = "Bible Databases"
description = "Translations & cross-references  ↗"
destination_url = "https://github.com/scrollmapper/bible_databases"
tooltip_text = "https://github.com/scrollmapper/bible_databases"

[node name="Deuterocanonical" parent="Margin/Layout/Credits" instance=ExtResource("credit")]
layout_mode = 2
custom_minimum_size = Vector2(0, 88)
title = "Deuterocanonical"
description = "Extended text datasets  ↗"
destination_url = "https://github.com/scrollmapper/bible_databases_deuterocanonical"
tooltip_text = "https://github.com/scrollmapper/bible_databases_deuterocanonical"

[node name="Labs" parent="Margin/Layout/Credits" instance=ExtResource("credit")]
layout_mode = 2
custom_minimum_size = Vector2(0, 88)
title = "Scrollmapper Labs"
description = "Research & development  ↗"
destination_url = "https://github.com/scrollmapper-labs"
tooltip_text = "https://github.com/scrollmapper-labs"
