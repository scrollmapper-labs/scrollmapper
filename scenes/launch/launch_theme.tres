[resource]
default_font = ExtResource("regular")
default_font_size = 15
Button/styles/normal = SubResource("card")
Button/styles/hover = SubResource("card_hover")
Button/styles/pressed = SubResource("card_pressed")
Button/styles/focus = SubResource("focus")
Button/colors/font_color = Color(0.87, 0.92, 0.95, 1)
Button/colors/font_hover_color = Color(1, 1, 1, 1)
Label/colors/font_color = Color(0.91, 0.95, 0.97, 1)
Title/base_type = &"Label"
Title/fonts/font = ExtResource("semibold")
CardTitle/base_type = &"Label"
CardTitle/fonts/font = ExtResource("semibold")
CardTitle/font_sizes/font_size = 25
Muted/base_type = &"Label"
Muted/colors/font_color = Color(0.58, 0.67, 0.74, 1)
QuietButton/base_type = &"Button"
QuietButton/styles/normal = SubResource("quiet")
ArtworkLabel/base_type = &"Label"
ArtworkLabel/colors/font_shadow_color = Color(0, 0, 0, 1)
ArtworkLabel/constants/shadow_offset_x = 2
ArtworkLabel/constants/shadow_offset_y = 2
ArtworkLabel/constants/shadow_outline_size = 3
VScrollBar/styles/scroll = SubResource("scroll_track")
VScrollBar/styles/grabber = SubResource("scroll_thumb")
VScrollBar/styles/grabber_highlight = SubResource("scroll_thumb")
VScrollBar/styles/grabber_pressed = SubResource("scroll_thumb")
HSeparator/constants/separation = 1
